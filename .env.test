# Environnement des TESTS UNITAIRES (npm test), committé et non secret.
#
# dotenv-oxy fait `require("dotenv/config")` au chargement de src/Utils/Env.ts,
# qui exige ces variables ; sans elles, tout test qui importe l'app plante au
# chargement. En local le vrai .env les fournissait, mais la CI GitHub n'en a
# pas — d'où ces valeurs FACTICES, chargées via DOTENV_CONFIG_PATH par les
# scripts `test`. Les tests sont unitaires : ils n'ouvrent aucune connexion,
# ces valeurs ne servent qu'à faire passer la validation d'environnement.
ENVIRONMENT=test
LISTEN_PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
LOG_LEVEL=error
DB_HOSTNAME=localhost
DB_DATABASE=deveye_test
DB_USERNAME=test
DB_PASSWORD=test
CRYPT_KEY_A=test-crypt-key-a
CRYPT_KEY_B=test-crypt-key-b
JWT_ACCESS_SECRET=test-jwt-access
JWT_REFRESH_SECRET=test-jwt-refresh
DEVICE_TOKEN_SECRET=test-device-token
