# Production environment for docker-compose.prod.yml.
# Usage: copy to .env.prod, fill in real secrets, then:
#   docker compose --env-file .env.prod -f docker-compose.prod.yml up --build -d

# --- Database (MySQL container) ---
DB_ROOT_PASSWORD=change-me-root
DB_DATABASE=DevEye
DB_USERNAME=deveye
DB_PASSWORD=change-me-app
DB_POOL_MAX=10

# --- HTTP / app ---
# Public origin of the deployment (used for CORS + cookies).
PUBLIC_ORIGIN=https://deveye.example.com
LOG_LEVEL=info
# Host port to publish the app on (container always listens on 8081).
HTTP_PORT_HOST=8081

# --- Field-level encryption (CRYPT_KEY_A must be 32 bytes for aes-256-ctr) ---
CRYPT_KEY_A=
CRYPT_KEY_B=

# --- JWT — generate with `openssl rand -base64 48` ---
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# --- Cookies ---
COOKIE_DOMAIN=

# --- Rate limit ---
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute
