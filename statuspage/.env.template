# La page d'état publique (`npm run dev:status` lit statuspage/.env).
# Voir Docs/STATUS_PAGE.md.

ENVIRONMENT=dev
STATUS_LISTEN_PORT=3100

# L'app telle qu'un visiteur la joint. En dev, le client Vite (5173) : sans
# build du client, le port 3000 ne sert pas l'accueil.
STATUS_DEVEYE_URL=http://localhost:5173
# L'écouteur des pages publiques (PUBLIC_LISTEN_PORT), s'il a son propre domaine.
STATUS_DEVEYE_PUBLIC_URL=

# Le même que STATUS_PROBE_TOKEN côté DevEye (openssl rand -hex 32).
STATUS_PROBE_TOKEN=

STATUS_DB_PATH=./statuspage/data/status.sqlite
STATUS_INTERVAL_SECONDS=60
# Le site vitrine, au pied de la page.
STATUS_SITE_URL=

# Les alertes ne partent qu'avec ENVIRONMENT=prod. Destinations : celles de la
# cible Système de DevEye, relues chez lui ; celle-ci en plus, toujours prévenue.
STATUS_ALERT_EMAIL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
