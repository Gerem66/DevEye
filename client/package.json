{
  "name": "deveye-client",
  "description": "Tool management tools",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check:sdk": "tsc -p tsconfig.sdkcheck.json",
    "check:css": "node scripts/check-css-modules.mjs",
    "ci": "npm run check:css && npm run lint && npm run typecheck && npm run check:sdk && npm run build",
    "test": "echo \"Error: no test specified\" && exit 1",
    "gen:css-types": "tcm src --include '**/*.module.css'",
    "clean": "rm -rf ./build ./dist ./node_modules package-lock.json"
  },
  "author": "Gerem",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "framer-motion": "^12.40.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.4.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "@vitejs/plugin-react": "^5.0.1",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typed-css-modules": "^0.9.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.40.0",
    "vite": "^7.1.3"
  }
}
