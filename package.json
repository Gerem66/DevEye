{
  "name": "deveye",
  "version": "0.6.2",
  "description": "DevEye — Fastify API + React web client (single product repo)",
  "main": "dist/index.js",
  "type": "module",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch index.ts",
    "dev:client": "wait-on tcp:3000 && npm --prefix client run dev",
    "start": "tsx index.ts",
    "build": "npm run build:client",
    "build:client": "npm --prefix client run build",
    "lint": "eslint index.ts src",
    "lint:fix": "eslint index.ts src --fix",
    "typecheck": "tsc --noEmit",
    "ci": "npm run lint && npm run typecheck",
    "clean": "rm -rf node_modules client/node_modules client/build package-lock.json",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "Gerem",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "deveye-types": "npm:@gerem66/deveye-types@^0.6.3",
    "dotenv": "^17.2.1",
    "dotenv-oxy": "^1.0.4",
    "fastify": "^5.8.5",
    "jose": "^6.2.3",
    "mysql2": "^3.22.5",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "wait-on": "^9.0.10"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  }
}
