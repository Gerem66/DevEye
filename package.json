{
  "name": "deveye",
  "version": "0.20.0",
  "description": "DevEye — Fastify API + React web client (single product repo)",
  "main": "dist/index.js",
  "type": "module",
  "workspaces": [
    "client",
    "features/*"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch index.ts",
    "dev:client": "wait-on tcp:3000 && npm --prefix client run dev",
    "start": "tsx index.ts",
    "build": "npm run build:client",
    "build:client": "npm --prefix client run build",
    "lint": "eslint index.ts src scripts",
    "lint:features": "eslint features",
    "lint:fix": "eslint index.ts src scripts --fix",
    "lint:fix:features": "eslint features --fix",
    "format:check": "prettier --check \"*.json\" \"*.md\" \".github/**/*.yml\" \"docker-compose*.yml\" \"Docs/**/*.md\" \"agent/*.md\" \"client/*.json\" \"client/index.html\" \"client/src/**/*.css\"",
    "format:check:features": "prettier --check \"features/**/*.json\" \"features/*/README.md\" \"features/*/src/**/*.css\"",
    "format:fix": "prettier --write \"*.json\" \"*.md\" \".github/**/*.yml\" \"docker-compose*.yml\" \"Docs/**/*.md\" \"agent/*.md\" \"client/*.json\" \"client/index.html\" \"client/src/**/*.css\"",
    "format:fix:features": "prettier --write \"features/**/*.json\" \"features/*/README.md\" \"features/*/src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "typecheck:features": "tsc -p features/tsconfig.server.json && tsc -p features/tsconfig.json",
    "ci": "npm run gen:features:local && npm run lint && npm run format:check && npm run typecheck && npm test && npm run gen:features -- --check",
    "ci:features": "npm run lint:features && npm run format:check:features && npm run typecheck:features && npm run test:features",
    "ci:smoke": "tsx scripts/smoke-all.ts",
    "ci:agent": "cd agent; /usr/bin/cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test",
    "clean": "rm -rf node_modules client/node_modules client/build package-lock.json",
    "test": "DOTENV_CONFIG_PATH=.env.test NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx --test \"src/**/*.test.ts\" \"scripts/lib/*.test.ts\"",
    "test:features": "DOTENV_CONFIG_PATH=.env.test tsx --test \"features/*/src/**/*.test.ts\"",
    "gen:features": "tsx scripts/gen-features.ts",
    "gen:features:local": "tsx scripts/gen-features.ts --ensure-local",
    "smoke:feature": "tsx scripts/smoke-feature.ts",
    "uninstall:feature": "tsx scripts/uninstall-feature.ts",
    "rotate:server-key": "tsx scripts/rotate-server-key.ts",
    "reseal:server-key": "tsx scripts/reseal-server-key.ts",
    "dev:sync-feature": "scripts/dev-sync-feature.sh",
    "restore:backup": "node scripts/restore-backup.mjs",
    "prestart": "npm run gen:features:local"
  },
  "author": "Gerem",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "@deveye/types": "^0.20.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.2.0",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.1",
    "dotenv-oxy": "^1.0.4",
    "fastify": "^5.8.5",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.13.10",
    "mysql2": "^3.22.5",
    "nodemailer": "^10.0.10",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "qrcode": "^1.5.4",
    "tsx": "^4.20.5",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "wait-on": "^9.0.10"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  },
  "overrides": {
    "mailauth": {
      "joi": "^18.2.9",
      "nodemailer": "^10.0.10"
    }
  }
}
