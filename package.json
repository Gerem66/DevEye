{
  "name": "deveye",
  "version": "0.14.3",
  "description": "DevEye — Fastify API + React web client (single product repo)",
  "main": "dist/index.js",
  "type": "module",
  "workspaces": [
    "client",
    "features/*"
  ],
  "scripts": {
    "install:all": "npm install",
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch index.ts",
    "dev:client": "wait-on tcp:3000 && npm --prefix client run dev",
    "start": "tsx index.ts",
    "build": "npm run build:client",
    "build:client": "npm --prefix client run build",
    "lint": "eslint index.ts src features scripts",
    "lint:fix": "eslint index.ts src --fix",
    "typecheck": "tsc --noEmit",
    "ci": "npm run gen:features:local && npm run lint && npm run typecheck && npm run ci:rules && npm run gen:features -- --check",
    "ci:rules": "tsx scripts/check-rules.ts",
    "ci:agent": "cd agent; /usr/bin/cargo fmt --check && cargo clippy --all-targets -- -D warnings",
    "clean": "rm -rf node_modules client/node_modules client/build package-lock.json",
    "test": "tsx --test \"src/**/*.test.ts\" \"features/*/src/**/*.test.ts\" \"scripts/lib/*.test.ts\"",
    "gen:features": "tsx scripts/gen-features.ts",
    "gen:features:local": "tsx scripts/gen-features.ts --ensure-local",
    "smoke:feature": "tsx scripts/smoke-feature.ts",
    "uninstall:feature": "tsx scripts/uninstall-feature.ts",
    "dev:sync-feature": "scripts/dev-sync-feature.sh",
    "restore:backup": "node scripts/restore-backup.mjs",
    "prestart": "npm run gen:features:local"
  },
  "author": "Gerem",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "@fastify/websocket": "^11.2.0",
    "argon2": "^0.44.0",
    "bcryptjs": "^3.0.3",
    "deveye-types": "npm:@deveye/types@^0.15.0",
    "dotenv": "^17.2.1",
    "dotenv-oxy": "^1.0.4",
    "fastify": "^5.8.5",
    "imapflow": "^1.6.5",
    "jose": "^6.2.3",
    "libphonenumber-js": "^1.13.10",
    "mailparser": "^3.9.14",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.3",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "sanitize-html": "^2.17.6",
    "socks": "^2.8.9",
    "ssh2": "^1.17.0",
    "tsx": "^4.20.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.21.0",
    "@types/sanitize-html": "^2.16.1",
    "@types/ssh2": "^1.15.5",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.41.0",
    "wait-on": "^9.0.10"
  },
  "allowScripts": {
    "argon2@0.44.0": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "fsevents@2.3.3": true
  }
}
