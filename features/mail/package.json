{
  "name": "deveye-feature-mail",
  "version": "0.0.0",
  "private": true,
  "description": "Mail, au format module : boîtes IMAP et OAuth de l'espace, cache des dossiers et des messages, synchronisation de fond, envoi, et le transport des alertes e-mail des autres features, treizième native rapatriée sur le SDK des features.",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server/index.ts",
    "./client": "./src/client/index.tsx",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "imapflow": "^1.6.5",
    "mailparser": "^3.9.14",
    "nodemailer": "^9.0.3",
    "sanitize-html": "^2.17.6"
  },
  "devDependencies": {
    "@types/mailparser": "^3.4.6",
    "@types/nodemailer": "^8.0.1",
    "@types/sanitize-html": "^2.16.1"
  },
  "peerDependencies": {
    "@deveye/types": ">=0.15.2",
    "react": "^19.0.0",
    "zod": "^4.0.0"
  }
}
