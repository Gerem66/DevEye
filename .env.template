#
# Environment
#
ENVIRONMENT=dev

#
# HTTP server
#
LISTEN_PORT=3000
# Browser origin (CORS). Host dev: Vite serves the client on :5173 and proxies
# /api + /ws to this server. Docker/prod: the server serves the client, so this
# is the app's own public origin.
PUBLIC_ORIGIN=http://localhost:3000

#
# Logs (pino levels: fatal/error/warn/info/debug/trace)
#
LOG_LEVEL=info
LOG_PATH=./logs

#
# SSL (only required outside dev when not behind a reverse proxy)
#
SSL_PRIVATE_KEY_PATH=
SSL_CERTIFICATE_PATH=

#
# MySQL
#
DB_HOSTNAME=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
DB_POOL_MAX=10

#
# Field-level encryption (CRYPT_KEY_A must be 32 bytes for aes-256-ctr)
#
CRYPT_KEY_A=
CRYPT_KEY_B=

#
# JWT — generate with `openssl rand -base64 48`
#
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

#
# Device (agent) tokens — generate with `openssl rand -base64 48`
#
DEVICE_TOKEN_SECRET=
# Lifetime of a machine link code (seconds)
LINK_CODE_TTL_SECONDS=300

#
# Directory the server serves the prebuilt agent binaries from.
# Optional — defaults to `agent/dist` (relative to the server's working dir).
#
AGENT_DIST_DIR=

#
# Two-factor authentication (TOTP)
#
TWOFA_ISSUER=DevEye
TWOFA_CHALLENGE_TTL_SECONDS=300

#
# Metrics/presence retention (days)
#
METRICS_RETENTION_DAYS=30

#
# Process-history retention (days) — separate, shorter default (bulkiest data)
#
PROCESS_RETENTION_DAYS=1

#
# Cookies
#
COOKIE_DOMAIN=

#
# Rate limit (window uses ms or "<n> <unit>" syntax, e.g. "1 minute")
#
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW=1 minute

#
# Private npm (GitHub Packages) used by Docker builds
#
GITHUB_PACKAGES_TOKEN=

#
# Agent binaries baked into the image (build-time only). The token needs
# `contents:read` to fetch the release assets; empty → reuses GITHUB_PACKAGES_TOKEN.
# AGENT_RELEASE_TAG empty → "latest". NB: only effective if forwarded as build
# args in docker-compose (compose passes GITHUB_PACKAGES_TOKEN by default).
#
AGENT_DOWNLOAD_TOKEN=
AGENT_RELEASE_TAG=
